---
interface NavItem {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  items?: NavItem[];
}

const defaultItems: NavItem[] = [
  { label: "Dashboard", href: "/" },
  { label: "Settings", href: "/settings" },
  { label: "Documentation", href: "/docs" },
];

const { items = defaultItems } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-header">
    <h2>E-Recadero</h2>
    <span class="version">v1.0.0</span>
  </div>

  <nav class="sidebar-nav">
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} class="nav-link">
              {item.icon && <span class="icon">{item.icon}</span>}
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    width: 250px;
    background: #2c3e50;
    color: white;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
    border-right: 1px solid #1a252f;
  }

  .sidebar-header {
    padding: 1.5rem;
    border-bottom: 1px solid #34495e;
  }

  .sidebar-header h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1.2rem;
  }

  .version {
    font-size: 0.75rem;
    opacity: 0.7;
    display: block;
  }

  .sidebar-nav {
    padding: 1rem 0;
  }

  .sidebar-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-nav li {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    color: #ecf0f1;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nav-link:hover {
    background: #34495e;
  }

  .icon {
    display: inline-flex;
    width: 1.2rem;
    height: 1.2rem;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .sidebar {
      width: 100%;
      height: auto;
      position: static;
    }

    .sidebar-nav ul {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
