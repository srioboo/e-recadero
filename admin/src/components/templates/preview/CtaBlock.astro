---
import type { CtaContent } from '@/lib/types';

interface Props {
  content: CtaContent;
}

const { content } = Astro.props;
const style = content.button_style || 'primary';
const size = content.button_size || 'medium';
---

<section class="cta-block">
  <a href={content.link} class={`cta-block__button cta-block__button--${style} cta-block__button--${size}`}>
    {content.text}
  </a>
</section>

<style>
  .cta-block {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .cta-block__button {
    display: inline-block;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 600;
  }

  .cta-block__button--primary {
    background: #2563eb;
    color: #fff;
  }

  .cta-block__button--primary:hover {
    background: #1d4ed8;
  }

  .cta-block__button--secondary {
    background: #e5e7eb;
    color: #111827;
  }

  .cta-block__button--secondary:hover {
    background: #d1d5db;
  }

  .cta-block__button--small {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .cta-block__button--medium {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .cta-block__button--large {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }
</style>
