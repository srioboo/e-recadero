---
import { resolveCategories } from '@/lib/catalog';
import type { CategoryListContent } from '@/lib/types';

interface Props {
  content: CategoryListContent;
}

const { content } = Astro.props;

// Mirrors front/src/components/templates/CategoryListBlock.astro's graceful
// omission of unresolved category IDs (FR-006) — see T048 parity test.
const categories = await resolveCategories(content.category_ids || []);
const itemsPerRow = content.items_per_row || 3;
---

<section class="category-list-block">
  {categories.length > 0 ? (
    <div class="category-list-block__grid" style={`--items-per-row: ${itemsPerRow}`}>
      {categories.map((category) => (
        <div class="category-list-block__item">
          {category.image_url && <img src={category.image_url} alt={category.name} />}
          <span class="category-list-block__name">{category.name}</span>
        </div>
      ))}
    </div>
  ) : (
    <p class="category-list-block__empty">No categories available.</p>
  )}
</section>

<style>
  .category-list-block {
    padding: 2rem 1.5rem;
  }

  .category-list-block__grid {
    display: grid;
    grid-template-columns: repeat(var(--items-per-row, 3), minmax(0, 1fr));
    gap: 1rem;
  }

  .category-list-block__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #f9fafb;
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .category-list-block__item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .category-list-block__name {
    font-weight: 600;
  }

  .category-list-block__empty {
    text-align: center;
    color: #6b7280;
    padding: 2rem 0;
  }
</style>
