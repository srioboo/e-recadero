---
import ProductCard from '../catalog/ProductCard.astro';
import { resolveProducts } from '../../lib/templates';
import type { FeaturedProductsContent } from '../../types/templates';

interface Props {
  content: FeaturedProductsContent;
}

const { content } = Astro.props;

// FR-006: omit any product IDs that no longer resolve instead of failing the page
const products = await resolveProducts(content.products || []);
const layout = content.layout || 'grid';
---

<section class="featured-products-block">
  {content.title && <h2 class="featured-products-block__title">{content.title}</h2>}
  {products.length > 0 ? (
    <div class={`featured-products-block__items featured-products-block__items--${layout}`}>
      {products.map((product) => (
        <div class="featured-products-block__item">
          <ProductCard product={product} />
        </div>
      ))}
    </div>
  ) : (
    <p class="featured-products-block__empty">No featured products available.</p>
  )}
</section>

<style>
  .featured-products-block {
    padding: 2rem 1.5rem;
  }

  .featured-products-block__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .featured-products-block__items--grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .featured-products-block__items--carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .featured-products-block__items--carousel .featured-products-block__item {
    flex: 0 0 220px;
    scroll-snap-align: start;
  }

  .featured-products-block__empty {
    text-align: center;
    color: #6b7280;
    padding: 2rem 0;
  }
</style>
