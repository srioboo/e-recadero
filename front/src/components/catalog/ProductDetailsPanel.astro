---
import RatingStars from '../shared/RatingStars.astro';
import PriceDisplay from '../shared/PriceDisplay.astro';
import type { Product, ProductVariant } from '../../types/catalog';

interface Props {
  product: Product;
  availableQuantity?: number;
  reorderStatus?: 'IN_STOCK' | 'LOW_STOCK' | 'OUT_OF_STOCK';
}

const {
  product,
  availableQuantity = 0,
  reorderStatus = 'IN_STOCK',
} = Astro.props;

// Mock rating data
const rating = 4.5;
const reviewCount = 24;
const isOutOfStock = availableQuantity === 0;
const isLowStock = availableQuantity > 0 && availableQuantity < 5;

const attributes = product.attributes || [];
const primaryImage = product.images?.[0];
---

<div class="bg-white rounded-lg shadow p-6">
  <!-- Product Info -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">{product.name}</h1>

    <!-- SKU -->
    <p class="text-sm text-gray-500 mb-3">SKU: {product.sku}</p>

    <!-- Rating -->
    <div class="mb-4">
      <RatingStars rating={rating} reviewCount={reviewCount} size="md" />
    </div>

    <!-- Description -->
    {
      product.description && (
        <p class="text-gray-600 mb-4">{product.description}</p>
      )
    }
  </div>

  <!-- Price Section -->
  <div class="bg-gray-50 rounded-lg p-4 mb-6">
    <PriceDisplay
      basePrice={product.base_price}
      availableQuantity={availableQuantity}
      lowStockThreshold={5}
    />
  </div>

  <!-- Availability Status -->
  <div class="mb-6">
    {
      isOutOfStock && (
        <div class="bg-red-50 border border-red-200 rounded-lg p-3 flex items-center gap-2">
          <span class="text-red-600 font-bold">●</span>
          <span class="text-red-700 text-sm">Out of Stock</span>
        </div>
      )
    }
    {
      isLowStock && (
        <div class="bg-orange-50 border border-orange-200 rounded-lg p-3 flex items-center gap-2">
          <span class="text-orange-600 font-bold">●</span>
          <span class="text-orange-700 text-sm">
            Low Stock - {availableQuantity} left
          </span>
        </div>
      )
    }
    {
      !isOutOfStock && !isLowStock && (
        <div class="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center gap-2">
          <span class="text-green-600 font-bold">●</span>
          <span class="text-green-700 text-sm">In Stock</span>
        </div>
      )
    }
  </div>

  <!-- Variant Selector -->
  {
    attributes && attributes.length > 0 && (
      <div class="mb-6 space-y-4">
        <h3 class="font-semibold text-gray-900">Options</h3>
        {attributes.map((attr) => (
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              {attr.name}
            </label>
            <select
              name={attr.name.toLowerCase()}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              aria-label={`Select ${attr.name}`}
            >
              <option value="">Choose {attr.name}</option>
              {attr.values.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </div>
        ))}
      </div>
    )
  }

  <!-- Quantity Selector -->
  {
    !isOutOfStock && (
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="px-3 py-2 border border-gray-300 rounded hover:bg-gray-100 transition-colors"
            aria-label="Decrease quantity"
          >
            −
          </button>
          <input
            type="number"
            name="quantity"
            value="1"
            min="1"
            max={Math.max(1, availableQuantity)}
            class="w-16 px-3 py-2 border border-gray-300 rounded text-center focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Quantity"
          />
          <button
            type="button"
            class="px-3 py-2 border border-gray-300 rounded hover:bg-gray-100 transition-colors"
            aria-label="Increase quantity"
          >
            +
          </button>
        </div>
      </div>
    )
  }

  <!-- Add to Cart Button -->
  <button
    class={`w-full py-3 px-4 rounded-lg font-semibold text-white transition-colors mb-3 ${
      isOutOfStock
        ? 'bg-gray-400 cursor-not-allowed'
        : 'bg-blue-600 hover:bg-blue-700'
    }`}
    disabled={isOutOfStock}
    aria-label="Add to cart"
  >
    {isOutOfStock ? 'Out of Stock' : 'Add to Cart'}
  </button>

  <!-- Wishlist Button -->
  <button
    class="w-full py-3 px-4 rounded-lg font-semibold text-gray-700 bg-gray-200 hover:bg-gray-300 transition-colors"
    aria-label="Add to wishlist"
  >
    ♡ Add to Wishlist
  </button>

  <!-- Product Details Section -->
  {
    product.long_description && (
      <div class="mt-8 border-t pt-6">
        <h3 class="font-semibold text-gray-900 mb-3">Product Details</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          {product.long_description}
        </p>
      </div>
    )
  }

  <!-- Variants List -->
  {
    product.variants && product.variants.length > 0 && (
      <div class="mt-8 border-t pt-6">
        <h3 class="font-semibold text-gray-900 mb-3">Available Variants</h3>
        <div class="space-y-2">
          {product.variants.map((variant: ProductVariant) => (
            <div class="flex justify-between items-center text-sm p-2 bg-gray-50 rounded">
              <span class="text-gray-700">
                {Object.values(variant.variant_attributes).join(' - ')}
              </span>
              <span class="font-semibold text-gray-900">
                {new Intl.NumberFormat('es-ES', {
                  style: 'currency',
                  currency: 'EUR',
                }).format(variant.price)}
              </span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
