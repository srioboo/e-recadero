---
import type { Category } from '../../types/catalog';

interface Props {
  categories: Category[];
  selectedCategoryId?: string;
}

const { categories, selectedCategoryId } = Astro.props;

const isSelected = (categoryId: string) => categoryId === selectedCategoryId;
---

<div class="bg-white rounded-lg shadow p-4 md:p-6">
  <h2 class="text-lg font-bold text-gray-900 mb-4">Categories</h2>

  <nav class="space-y-2">
    <!-- All Products Link -->
    <a
      href="/catalog"
      class={`block px-3 py-2 rounded transition-colors ${
        !selectedCategoryId
          ? 'bg-blue-100 text-blue-600 font-semibold'
          : 'text-gray-700 hover:bg-gray-100'
      }`}
      aria-current={!selectedCategoryId ? 'page' : undefined}
    >
      All Products
    </a>

    <!-- Category List -->
    {
      categories.map((category) => (
        <a
          href={`/catalog/${category.slug}`}
          class={`block px-3 py-2 rounded transition-colors ${
            isSelected(category.id)
              ? 'bg-blue-100 text-blue-600 font-semibold'
              : 'text-gray-700 hover:bg-gray-100'
          }`}
          aria-current={isSelected(category.id) ? 'page' : undefined}
        >
          <span class="flex justify-between items-center">
            <span>{category.name}</span>
            {category.children && category.children.length > 0 && (
              <span class="text-xs text-gray-500">({category.children.length})</span>
            )}
          </span>
        </a>
      ))
    }
  </nav>
</div>
