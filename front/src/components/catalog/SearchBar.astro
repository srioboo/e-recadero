---
interface Props {
  initialQuery?: string;
  onSearch?: (query: string) => void;
}

const { initialQuery = '', onSearch } = Astro.props;
---

<div class="bg-white rounded-lg shadow p-4 mb-6">
  <form method="get" class="flex gap-2">
    <input
      type="hidden"
      name="page"
      value="1"
    />
    <div class="flex-1 relative">
      <input
        type="text"
        name="q"
        placeholder="Search products..."
        defaultValue={initialQuery}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
        aria-label="Search products"
      />
    </div>
    <button
      type="submit"
      class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
      aria-label="Search"
    >
      Search
    </button>
  </form>

  <!-- Filter Section -->
  <details class="mt-4 border-t pt-4">
    <summary class="cursor-pointer font-semibold text-gray-900 hover:text-blue-600 transition-colors">
      Filter
    </summary>

    <div class="mt-4 space-y-4">
      <!-- Price Range -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Price Range
        </label>
        <div class="flex gap-2">
          <input
            type="number"
            name="minPrice"
            placeholder="Min"
            step="0.01"
            class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Minimum price"
          />
          <input
            type="number"
            name="maxPrice"
            placeholder="Max"
            step="0.01"
            class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Maximum price"
          />
        </div>
      </div>

      <!-- Sort -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Sort By
        </label>
        <select
          name="sort"
          class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          aria-label="Sort products"
        >
          <option value="created_at_desc">Newest</option>
          <option value="price_asc">Price: Low to High</option>
          <option value="price_desc">Price: High to Low</option>
          <option value="name_asc">Name: A to Z</option>
          <option value="popularity">Most Popular</option>
        </select>
      </div>

      <!-- Stock Status -->
      <div>
        <label class="flex items-center gap-2 cursor-pointer">
          <input
            type="checkbox"
            name="inStockOnly"
            value="true"
            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
            aria-label="In stock only"
          />
          <span class="text-sm text-gray-700">In Stock Only</span>
        </label>
      </div>

      <!-- Apply Filters -->
      <button
        type="submit"
        class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors font-medium text-sm"
      >
        Apply Filters
      </button>
    </div>
  </details>
</div>
