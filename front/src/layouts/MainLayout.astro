---
import LocaleSwitcher from '@/components/LocaleSwitcher.astro';
import { getMessage, getUserLocale } from '@/lib/i18n';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentLocale = getUserLocale();
const t = (key: string) => getMessage(key, currentLocale);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="E-Recadero - Your trusted digital platform" />
    <title>{title} - E-Recadero</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: system-ui, -apple-system, sans-serif;
        background: #ffffff;
        color: #333;
      }

      body {
        line-height: 1.6;
      }

      .page-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      header {
        background: white;
        border-bottom: 1px solid #ddd;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: bold;
        color: #2c3e50;
        text-decoration: none;
      }

      nav a {
        margin-left: 2rem;
        color: #666;
        text-decoration: none;
        transition: color 0.2s;
      }

      nav a:hover {
        color: #2c3e50;
      }

      main {
        flex: 1;
      }

      footer {
        background: #2c3e50;
        color: white;
        padding: 2rem;
        text-align: center;
        margin-top: 4rem;
      }

      @media (max-width: 768px) {
        .header-content {
          flex-direction: column;
          gap: 1rem;
        }

        nav {
          display: flex;
          gap: 1rem;
          flex-wrap: wrap;
        }

        nav a {
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-layout">
      <header>
        <div class="header-content">
          <a href="/" class="logo">E-Recadero</a>
          <nav>
            <a href="/">{t('common.home')}</a>
            <a href="/about">{t('common.about')}</a>
            <a href="/contact">{t('common.contact')}</a>
          </nav>
          <div style="margin-left: auto;">
            <LocaleSwitcher currentLocale={currentLocale} />
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>&copy; 2026 E-Recadero. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>
