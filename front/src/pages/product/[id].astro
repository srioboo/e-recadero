---
import ProductDetailsPanel from '../../components/catalog/ProductDetailsPanel.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import { fetchProductDetail, fetchProductAvailability, fetchProducts } from '../../lib/api';

export const prerender = false;

// Get product ID from URL
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/catalog');
}

let product = null;
let availability = null;
let relatedProducts = [];
let error = null;

try {
  // Fetch product details
  product = await fetchProductDetail(id);

  // Fetch product availability
  availability = await fetchProductAvailability(id);

  // Fetch related products from same category
  if (product && product.category_id) {
    const relatedResponse = await fetchProducts({
      categoryId: product.category_id,
      limit: 4,
    });
    // Filter out current product
    relatedProducts = (relatedResponse.data || []).filter(
      (p) => p.id !== product.id
    );
  }
} catch (err) {
  console.error('Failed to load product:', err);
  error = 'Product not found or could not be loaded.';
}

// Get primary variant availability
const primaryVariantAvailability = availability?.variants?.[0];
const availableQuantity = primaryVariantAvailability?.available_quantity || 0;
const reorderStatus = primaryVariantAvailability?.reorder_status || 'OUT_OF_STOCK';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      product && (
        <>
          <title>{product.name} | E-Recadero</title>
          <meta name="description" content={product.description || product.name} />
          <meta property="og:title" content={product.name} />
          <meta
            property="og:description"
            content={product.description || product.name}
          />
          {product.images?.[0]?.url && (
            <meta property="og:image" content={product.images[0].url} />
          )}
        </>
      )
    }
  </head>
  <body>
    <div class="min-h-screen bg-gray-50">
      <!-- Breadcrumb -->
      <div class="bg-white border-b">
        <div class="max-w-7xl mx-auto px-4 py-4">
          <nav class="flex gap-2 text-sm">
            <a href="/catalog" class="text-blue-600 hover:text-blue-700">
              Catalog
            </a>
            <span class="text-gray-400">/</span>
            {
              product && (
                <>
                  <a
                    href={`/catalog?categoryId=${product.category_id}`}
                    class="text-blue-600 hover:text-blue-700"
                  >
                    Category
                  </a>
                  <span class="text-gray-400">/</span>
                  <span class="text-gray-600">{product.name}</span>
                </>
              )
            }
          </nav>
        </div>
      </div>

      <!-- Main Content -->
      <div class="max-w-7xl mx-auto px-4 py-8">
        {
          error && (
            <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
              <p class="text-red-700 font-semibold">{error}</p>
              <a
                href="/catalog"
                class="text-red-600 hover:text-red-700 text-sm mt-4 inline-block"
              >
                ← Back to Catalog
              </a>
            </div>
          )
        }

        {
          product && (
            <>
              <!-- Product Detail Section -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
                <!-- Product Images -->
                <div class="lg:col-span-1">
                  <div class="bg-white rounded-lg shadow overflow-hidden">
                    {product.images && product.images.length > 0 ? (
                      <div class="aspect-square bg-gray-100 flex items-center justify-center">
                        <img
                          src={product.images[0].url}
                          alt={product.images[0].alt || product.name}
                          class="w-full h-full object-cover"
                        />
                      </div>
                    ) : (
                      <div class="aspect-square bg-gray-100 flex items-center justify-center">
                        <span class="text-gray-400">No image</span>
                      </div>
                    )}
                    {product.images && product.images.length > 1 && (
                      <div class="p-4 grid grid-cols-4 gap-2 bg-white">
                        {product.images.map((img, idx) => (
                          <button
                            type="button"
                            class={`aspect-square rounded overflow-hidden border-2 ${
                              idx === 0
                                ? 'border-blue-600'
                                : 'border-gray-200 hover:border-gray-300'
                            }`}
                            aria-label={`View image ${idx + 1}`}
                          >
                            <img
                              src={img.url}
                              alt={img.alt || `Product image ${idx + 1}`}
                              class="w-full h-full object-cover"
                            />
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <!-- Product Details Panel -->
                <div class="lg:col-span-2">
                  <ProductDetailsPanel
                    product={product}
                    availableQuantity={availableQuantity}
                    reorderStatus={reorderStatus}
                  />
                </div>
              </div>

              <!-- Related Products -->
              {relatedProducts.length > 0 && (
                <div class="border-t pt-8">
                  <h2 class="text-2xl font-bold text-gray-900 mb-6">
                    Related Products
                  </h2>
                  <ProductGrid
                    products={relatedProducts}
                    columns={{ mobile: 1, tablet: 2, desktop: 4 }}
                  />
                </div>
              )}
            </>
          )
        }
      </div>
    </div>
  </body>
</html>
